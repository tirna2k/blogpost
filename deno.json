{
  "tasks": {
    "dev": "deno run --watch main.ts",
    "start": "deno run main.ts",
    "test": "deno test",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno fmt --check && deno lint && deno test"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "compilerOptions": {
    "strict": true
  }
}
